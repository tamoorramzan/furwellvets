<!-- /sections/furrwell-team.liquid -->
<div class="fw-scope">
  <section class="fw-team">
    <div class="fw-wrap">
      <div class="fw-team-head">
        {% if section.settings.eyebrow != blank %}<span class="fw-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2>{{ section.settings.heading | default: 'Meet the vets behind every recommendation' }}</h2>
      </div>
      <div class="fw-team-grid">
        {% for block in section.blocks %}
        <div class="fw-card fw-team-card" {{ block.shopify_attributes }}>
          <div class="fw-team-photo">
            {% if block.settings.photo != blank %}
            <img src="{{ block.settings.photo | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {% else %}
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            {% endif %}
          </div>
          <div class="fw-team-body">
            <h3>{{ block.settings.name | default: '[Dr. Name]' }}</h3>
            <p>{{ block.settings.role | default: '[Veterinarian, DVM]' }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Team",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the vets behind every recommendation" }
  ],
  "blocks": [
    {
      "type": "vet",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role", "default": "Veterinarian, DVM" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
