<!-- /sections/furrwell-product-grid.liquid -->
<div class="fw-scope">
  <section class="fw-products">
    <div class="fw-wrap">
      <div class="fw-section-head">
        <h2>{{ section.settings.heading | default: 'Best Sellers' }}</h2>
        <span class="fw-rule"></span>
        {% if section.settings.collection != blank %}
        <a href="{{ collections[section.settings.collection].url }}" style="font-size:14px;font-weight:700;">Shop all &rarr;</a>
        {% endif %}
      </div>

      {% assign coll = collections[section.settings.collection] %}
      <div class="fw-products-grid">
        {% if coll != blank and coll.products.size > 0 %}
          {% for product in coll.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="fw-card fw-product-card">
            <div class="fw-product-img">
              {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
              {% else %}
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#c7c4ba" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5-11 11"/></svg>
              {% endif %}
            </div>
            <div class="fw-product-body">
              {% if product.type != blank %}<span class="fw-product-cat">{{ product.type }}</span>{% endif %}
              <span class="fw-product-title">{{ product.title }}</span>
              <span class="fw-product-price">
                {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
                {{ product.price | money }}
              </span>
            </div>
          </a>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
          <div class="fw-card fw-product-card">
            <div class="fw-product-img">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#c7c4ba" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5-11 11"/></svg>
            </div>
            <div class="fw-product-body">
              <span class="fw-product-title fw-ph">Select a collection to show products</span>
            </div>
          </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Product Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 }
  ]
}
{% endschema %}
