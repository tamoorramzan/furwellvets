<!-- /sections/furrwell-newsletter.liquid -->
<div class="fw-scope">
  <section class="fw-newsletter">
    <div class="fw-wrap fw-newsletter-inner">
      <div class="fw-newsletter-copy">
        <h2>{{ section.settings.heading | default: 'Pet care tips, in your inbox' }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>

      {% form 'customer', id: 'furrwell-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="fw-newsletter-form">
          <input type="email" name="contact[email]" placeholder="Your email address" required {% if form.errors %}value="{{ form.email }}"{% endif %}>
          <button type="submit" class="fw-btn-primary">{{ section.settings.button_label | default: 'Sign Up' }}</button>
        </div>
        {% if form.posted_successfully? %}
        <p class="fw-newsletter-note success">Thanks for signing up!</p>
        {% elsif form.errors %}
        <p class="fw-newsletter-note error">{{ form.errors.messages['form'] | default: 'Please enter a valid email address.' }}</p>
        {% endif %}
      {% endform %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pet care tips, in your inbox" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Seasonal advice from our vets, plus new arrivals and offers." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign Up" }
  ]
}
{% endschema %}
