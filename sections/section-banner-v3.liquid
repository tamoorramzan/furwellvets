<div data-section-id="{{ section.id }}" data-section-type="section-banner-v3" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{%endif%} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %} {% if section.settings.sections_layout == "dark" %}background: {{section.settings.sections_bg_color}};{% endif %}">
  <div class="section-banner-v3 mt-all">
    {% for block in section.blocks %}
    {% if block.type == 'collection' %}
    <div class="banner_box align-items-center" style="background-color:{{block.settings.color_background}};">
      <div class="banner-left  {% if block.settings.select_banner == 'banner_left' %}order-1 order-md-2 text-left {% else %}order-1 order-md-1 text-right {% endif %}" >
        
          {% if block.settings.titletop_banner != blank %}
          <h6 class="title" style="color : {{block.settings.color_titletop_banner}}">{{block.settings.titletop_banner}}</h6>
          {% endif %}
          {% if block.settings.title_banner != blank %}
          <h3 class="title_heading" style="color : {{block.settings.color_title_banner}}"> {{block.settings.title_banner}}</h3>
          {% endif %}
          {% if block.settings.description_banner != blank %}
          <div class="desc" style="color : {{block.settings.color_description_banner}}">{{block.settings.description_banner}}</div>
          {% endif %}
          {% if block.settings.buttom_banner != blank %}
          <a class="button button-{{block.id}}" href="{{block.settings.button_banner_url}}" style="color: {{block.settings.color_buttom_banner}}; background:{{block.settings.bgcolor_buttom_banner}};">
            <span>{{block.settings.buttom_banner}}</span>
          </a>
          {% endif %}
        
      </div>
      <div class="picture-banner {% if block.settings.select_banner == 'banner_left' %}order-2 order-md-1 {% else %}order-2 order-md-2 {% endif %}">
        <a href="{{block.settings.button_banner_url}}">
          {% if block.settings.image_banner != blank %}
          <img src="{{block.settings.image_banner|img_url:'master'}}" class="img-responsive " alt="">
          {% else %}
          <img src="//placehold.it/960x800" class="img-fluid" alt="">
          {% endif %}
        </a>
      </div>      
    </div>
    {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  {% if section.blocks.size > 0 %}
  {% for block in section.blocks %}
  {% if block.type == "collection" %}
  .section-banner-v3 .banner_box .banner-left .button-{{block.id}}:hover {
    color : {{block.settings.hovercolor_buttom_banner}} !important;
    background : {{block.settings.hoverbgcolor_buttom_banner}} !important;
  }
  {% endif %}
  {% endfor %}
  {% endif %}
</style>

