<!-- /sections/furrwell-category-slider.liquid -->
<div class="fw-scope">
  <section class="fw-cat-slider" data-fw-cat-slider>
    <div class="fw-wrap">
      <div class="fw-section-head">
        <h2>{{ section.settings.heading | default: 'Explore All Categories' }}</h2>
        <span class="fw-rule"></span>
        {% if section.blocks.size > 4 %}
        <div style="display:flex;gap:10px;">
          <button type="button" class="fw-arrow-btn" style="width:38px;height:38px;" data-fw-cat-prev aria-label="Previous">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="2.4"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button type="button" class="fw-arrow-btn" style="width:38px;height:38px;" data-fw-cat-next aria-label="Next">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="2.4"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
        {% endif %}
      </div>

      <div class="fw-cat-track-wrap">
        <div class="fw-cat-track">
          {% for block in section.blocks %}
            {% assign coll = collections[block.settings.collection] %}
            {% assign img = block.settings.image | default: coll.featured_image %}
            <div class="fw-card fw-cat-card" {{ block.shopify_attributes }}>
              <a href="{% if coll %}{{ coll.url }}{% else %}{{ block.settings.url }}{% endif %}" class="fw-cat-card-img" style="{% if img %}background-image:url('{{ img | img_url: '600x' }}');{% else %}background:{{ block.settings.fallback_color | default: '#e4ecf5' }};{% endif %}">
                <h3>{{ block.settings.label | default: coll.title }}</h3>
              </a>
              <div class="fw-cat-card-foot">
                <a href="{% if coll %}{{ coll.url }}{% else %}{{ block.settings.url }}{% endif %}">Shop the range &rarr;</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Category Slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore All Categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "Link (used if no collection selected)" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "color", "id": "fallback_color", "label": "Fallback background color", "default": "#e4ecf5" }
      ]
    }
  ],
  "max_blocks": 12,
  "default": {
    "blocks": [
      { "type": "category", "settings": { "label": "Dog" } },
      { "type": "category", "settings": { "label": "Cat" } },
      { "type": "category", "settings": { "label": "Small Pets" } },
      { "type": "category", "settings": { "label": "Birds" } }
    ]
  }
}
{% endschema %}
