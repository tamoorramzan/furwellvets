<!-- /sections/furrwell-collection-spotlight.liquid -->
<div class="fw-scope">
  {% assign coll = collections[section.settings.collection] %}
  <section class="fw-feature-banner">
    <div class="fw-wrap">
      <div class="fw-feature-inner">
        <div class="fw-feature-copy">
          {% if section.settings.eyebrow != blank %}<span class="fw-eyebrow" style="color:var(--fw-gold);">{{ section.settings.eyebrow }}</span>{% endif %}
          <h2>{{ section.settings.heading | default: coll.title }}</h2>
          {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
          {% if section.settings.button_label != blank %}
          <div style="margin-top:8px;">
            <a href="{% if coll %}{{ coll.url }}{% else %}{{ section.settings.button_url }}{% endif %}" class="fw-btn-primary">{{ section.settings.button_label }}</a>
          </div>
          {% endif %}
        </div>
        <div class="fw-feature-icon">
          {% if section.settings.icon != blank %}
          <img src="{{ section.settings.icon | img_url: '200x' }}" alt="">
          {% else %}
          <svg width="84" height="84" viewBox="0 0 24 24" fill="none" stroke="var(--fw-gold)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- case section.settings.icon_style -%}
              {%- when 'stethoscope' -%}
                <path d="M6 4H5a2 2 0 0 0-2 2v3.5a5.5 5.5 0 0 0 11 0V6a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 1 0 12 0v-3"/><path d="M11 3v2"/><path d="M6 3v2"/><circle cx="20" cy="10" r="2"/>
              {%- when 'calendar' -%}
                <rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/><path d="M10 16l2 2 3-3"/>
              {%- else -%}
                <path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/><path d="M9 12l2 2 4-4"/>
            {%- endcase -%}
          </svg>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Feature Banner",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Seasonal Wellness Edit" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Edit" },
    { "type": "url", "id": "button_url", "label": "Button link (used if no collection selected)" },
    { "type": "select", "id": "icon_style", "label": "Icon", "default": "shield", "options": [
      { "value": "shield", "label": "Shield" },
      { "value": "stethoscope", "label": "Stethoscope" },
      { "value": "calendar", "label": "Calendar" }
    ] },
    { "type": "image_picker", "id": "icon", "label": "Custom icon image", "info": "Replaces the icon above" }
  ]
}
{% endschema %}
