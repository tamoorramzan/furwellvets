<!-- /sections/furrwell-credibility.liquid -->
{%- liquid
  assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign wa_url = 'https://wa.me/' | append: wa_number
  if section.settings.whatsapp_message != blank
    assign wa_msg = section.settings.whatsapp_message | url_encode | replace: '+', '%20'
    assign wa_url = wa_url | append: '?text=' | append: wa_msg
  endif
-%}
<div class="fw-scope">
  <section class="fw-credibility">
    <div class="fw-wrap fw-credibility-inner">
      <div class="fw-credibility-copy">
        {% if section.settings.eyebrow != blank %}<span class="fw-eyebrow" style="color:var(--fw-gold);">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        {% if section.settings.button_label != blank and wa_number != blank %}
        <a href="{{ wa_url }}" class="fw-wa-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.13a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23s8.23 3.69 8.23 8.23-3.69 8.22-8.23 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
          {{ section.settings.button_label }}
        </a>
        {% endif %}
      </div>
      {% if section.blocks.size > 0 %}
      <div class="fw-stats-grid">
        {% for block in section.blocks %}
          {%- liquid
            if block.settings.link == 'whatsapp' or block.settings.link == blank
              assign card_url = wa_url
            elsif block.settings.link == 'map'
              assign map_q = block.settings.text | url_encode | replace: '+', '%20'
              assign card_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_q
            else
              assign card_url = block.settings.link
            endif
          -%}
        <a href="{{ card_url }}" class="fw-stat fw-info-card" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <span class="fw-info-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            {%- case block.settings.icon -%}
              {%- when 'pin' -%}<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
              {%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
              {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
              {%- when 'calendar' -%}<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/><path d="M10 16l2 2 3-3"/>
              {%- else -%}<path d="M6 4H5a2 2 0 0 0-2 2v3.5a5.5 5.5 0 0 0 11 0V6a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 1 0 12 0v-3"/><path d="M11 3v2"/><path d="M6 3v2"/><circle cx="20" cy="10" r="2"/>
            {%- endcase -%}
            </svg>
          </span>
          <span class="fw-info-title">{{ block.settings.title }}</span>
          <span class="fw-stat-label">{{ block.settings.text }}</span>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Clinic Intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our clinic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet FurrWell Vets Clinic" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "header", "content": "WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "info": "With country code, e.g. +923001234567", "default": "+923268828918" },
    { "type": "text", "id": "whatsapp_message", "label": "Pre-filled message", "default": "Hi FurrWell Vets Clinic, I'd like to book an appointment." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Chat on WhatsApp" }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "stethoscope", "options": [
          { "value": "pin", "label": "Location pin" },
          { "value": "phone", "label": "Phone" },
          { "value": "calendar", "label": "Calendar" },
          { "value": "clock", "label": "Clock" },
          { "value": "stethoscope", "label": "Stethoscope" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Visit us" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "link", "label": "Link", "default": "whatsapp", "info": "Type whatsapp to open WhatsApp, map to open the text above in Google Maps, or paste any link" }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "blocks": [
      { "type": "info", "settings": { "icon": "pin", "title": "Visit us", "text": "Plot 126, Block D2, WAPDA Town, Lahore", "link": "map" } },
      { "type": "info", "settings": { "icon": "phone", "title": "WhatsApp", "text": "+92 326 8828918", "link": "whatsapp" } },
      { "type": "info", "settings": { "icon": "calendar", "title": "Book a visit", "text": "Message us to book", "link": "whatsapp" } }
    ]
  }
}
{% endschema %}
