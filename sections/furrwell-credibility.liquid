<!-- /sections/furrwell-credibility.liquid -->
<div class="fw-scope">
  <section class="fw-credibility">
    <div class="fw-wrap fw-credibility-inner">
      <div class="fw-credibility-copy">
        {% if section.settings.eyebrow != blank %}<span class="fw-eyebrow" style="color:var(--fw-gold);">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      {% if section.blocks.size > 0 %}
      <div class="fw-stats-grid">
        {% for block in section.blocks %}
        <div class="fw-stat" {{ block.shopify_attributes }}>
          <div class="fw-stat-num">{{ block.settings.number }}</div>
          <div class="fw-stat-label">{{ block.settings.label }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Credibility",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why pet owners trust us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every product is reviewed by our own veterinary team" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "[X]" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years in practice" }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "blocks": [
      { "type": "stat", "settings": { "number": "[X]+", "label": "Years in practice" } },
      { "type": "stat", "settings": { "number": "[X]", "label": "Licensed vets" } },
      { "type": "stat", "settings": { "number": "[X]k+", "label": "Pets cared for" } }
    ]
  }
}
{% endschema %}
