    },
    {
      "type": "text",
      "id": "buttom_banner_bottom_right",
      "label": "Button banner",
      "default": "SHOP NOW"
    },
	{
      "type": "color",
      "id": "color_button4",
      "label": "Color Button"
    },
   {
      "type": "url",
      "id": "button_url_banner_bottom_right",
      "label": "URL button banner bottom right",
      "default": "/collections/all"
    },


	{
      "type": "header",
