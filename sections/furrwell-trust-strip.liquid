<!-- /sections/furrwell-trust-strip.liquid -->
<div class="fw-scope">
  <section class="fw-trust">
    <div class="fw-wrap fw-trust-grid">
      {% for block in section.blocks %}
      <div class="fw-trust-item" {{ block.shopify_attributes }}>
        <div class="fw-trust-icon" style="background:{{ block.settings.icon_bg | default: '#f0ece0' }};">
          {% if block.settings.icon != blank %}
          <img src="{{ block.settings.icon | img_url: '48x' }}" alt="" width="24" height="24">
          {% else %}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
          {% endif %}
        </div>
        <div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Trust Strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#f0ece0" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On qualifying orders" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "item", "settings": { "heading": "Free Delivery", "text": "On qualifying orders" } },
      { "type": "item", "settings": { "heading": "Vet-Formulated", "text": "Reviewed by our clinicians" } },
      { "type": "item", "settings": { "heading": "Easy Returns", "text": "30-day return window" } }
    ]
  }
}
{% endschema %}
