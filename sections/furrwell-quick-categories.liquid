<!-- /sections/furrwell-quick-categories.liquid -->
<div class="fw-scope">
  <section class="fw-quick-cats">
    <div class="fw-wrap">
      {% if section.settings.heading != blank %}
      <h2 style="font-size:24px;margin-bottom:24px;">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="fw-quick-grid">
        {% for block in section.blocks %}
          {% assign coll = collections[block.settings.collection] %}
          <a href="{% if coll %}{{ coll.url }}{% elsif block.settings.url != blank %}{{ block.settings.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="fw-quick-tile" style="background:{{ block.settings.bg_color | default: '#eef1e8' }};" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | img_url: '80x' }}" alt="">
            {% else %}
            {% render 'fw-pet-icon', icon: block.settings.icon_style %}
            {% endif %}
            <div>
              <h3>{{ block.settings.label | default: coll.title }}</h3>
              <p class="fw-quick-sub">
                {%- if block.settings.subtitle != blank -%}
                  {{ block.settings.subtitle }}
                {%- elsif coll and coll.products_count > 0 -%}
                  {{ coll.products_count }} {% if coll.products_count == 1 %}product{% else %}products{% endif %}
                {%- else -%}
                  Shop now
                {%- endif -%}
                <svg class="fw-quick-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg>
              </p>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Quick Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Pet" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "Link (used if no collection selected)" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "select", "id": "icon_style", "label": "Icon", "default": "paw", "options": [
          { "value": "dog", "label": "Dog" },
          { "value": "cat", "label": "Cat" },
          { "value": "fish", "label": "Fish" },
          { "value": "stethoscope", "label": "Stethoscope (vet)" },
          { "value": "paw", "label": "Paw" }
        ] },
        { "type": "image_picker", "id": "icon", "label": "Custom icon image", "info": "Replaces the icon above" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Leave empty to show the collection's product count" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#eef1e8" }
      ]
    }
  ],
  "max_blocks": 8,
  "default": {
    "blocks": [
      { "type": "tile", "settings": { "label": "Dog", "bg_color": "#e4ecf5", "icon_style": "dog" } },
      { "type": "tile", "settings": { "label": "Cat", "bg_color": "#f5ecd7", "icon_style": "cat" } },
      { "type": "tile", "settings": { "label": "Fish & Birds", "bg_color": "#e2f0ee", "icon_style": "fish" } },
      { "type": "tile", "settings": { "label": "Vet Services", "bg_color": "#f7e4da", "icon_style": "stethoscope", "subtitle": "Book a visit" } }
    ]
  }
}
{% endschema %}
