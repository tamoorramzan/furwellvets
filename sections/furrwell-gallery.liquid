<!-- /sections/furrwell-gallery.liquid -->
<div class="fw-scope">
  <section class="fw-gallery" id="fw-gallery-{{ section.id }}">
    <div class="fw-wrap">
      <div class="fw-gallery-head">
        {% if section.settings.eyebrow != blank %}<span class="fw-eyebrow" style="color:var(--fw-teal);">{{ section.settings.eyebrow }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h1 class="fw-gallery-title">{{ section.settings.heading }}</h1>{% endif %}
        {% if section.settings.text != blank %}<p class="fw-gallery-text">{{ section.settings.text }}</p>{% endif %}
      </div>

      {% assign photos = section.blocks | where: 'type', 'photo' %}
      {% if photos.size > 0 %}
      <div class="fw-gallery-grid fw-gallery-grid--{{ section.settings.columns }}">
        {% for block in photos %}
          {% if block.settings.image != blank %}
          <figure class="fw-gallery-item{% if block.settings.wide %} fw-gallery-item--wide{% endif %}" {{ block.shopify_attributes }}>
            <button type="button" class="fw-gallery-open" data-fw-gallery-open="{{ forloop.index0 }}" aria-label="View photo{% if block.settings.caption != blank %}: {{ block.settings.caption | escape }}{% endif %}">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 767px) 100vw, 33vw', widths: '400, 600, 900', alt: block.settings.caption }}
            </button>
            {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}
            <template data-fw-gallery-full data-caption="{{ block.settings.caption | escape }}">{{ block.settings.image | image_url: width: 1800 }}</template>
          </figure>
          {% else %}
          <figure class="fw-gallery-item fw-gallery-item--empty" {{ block.shopify_attributes }}>
            {{ 'image' | placeholder_svg_tag: 'fw-gallery-placeholder' }}
            <figcaption>Add a photo in the theme editor</figcaption>
          </figure>
          {% endif %}
        {% endfor %}
      </div>
      {% else %}
      <div class="fw-gallery-empty">
        <p>No photos yet. Open <strong>Online Store → Themes → Customize</strong>, go to the Gallery page and click <strong>Add Photo</strong>.</p>
      </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
      <div class="fw-gallery-cta">
        <a href="{{ section.settings.button_url | default: '/pages/contact#book-appointment' }}" class="fw-btn-primary">{{ section.settings.button_label }}</a>
      </div>
      {% endif %}
    </div>
  </section>

  <div class="fw-lightbox" data-fw-lightbox hidden>
    <button type="button" class="fw-lightbox-close" data-fw-lb-close aria-label="Close">&times;</button>
    <button type="button" class="fw-lightbox-nav is-prev" data-fw-lb-prev aria-label="Previous photo">&#8249;</button>
    <figure class="fw-lightbox-figure">
      <img src="" alt="" data-fw-lb-img>
      <figcaption data-fw-lb-cap></figcaption>
    </figure>
    <button type="button" class="fw-lightbox-nav is-next" data-fw-lb-next aria-label="Next photo">&#8250;</button>
  </div>
</div>

<style>
  .fw-gallery { padding: 56px 0 72px; }
  .fw-gallery-head { text-align: center; max-width: 680px; margin: 0 auto 36px; }
  .fw-gallery-title { font-family: 'Newsreader', Georgia, serif; font-size: 38px; color: var(--fw-navy); margin: 10px 0 12px; line-height: 1.15; }
  .fw-gallery-text { font-size: 15.5px; line-height: 1.65; color: #5d6476; margin: 0; }
  .fw-gallery-grid { display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0,1fr)); grid-auto-flow: dense; }
  .fw-gallery-grid--2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .fw-gallery-grid--4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
  .fw-gallery-item { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .fw-gallery-item--wide { grid-column: span 2; }
  .fw-gallery-open { display: block; padding: 0; border: 0; background: #eee; border-radius: 14px; overflow: hidden; cursor: zoom-in; aspect-ratio: 4 / 3; width: 100%; }
  .fw-gallery-item--wide .fw-gallery-open { aspect-ratio: 8 / 3; }
  .fw-gallery-open img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .fw-gallery-open:hover img { transform: scale(1.04); }
  .fw-gallery-item figcaption { font-size: 13.5px; color: #5d6476; padding: 0 4px; }
  .fw-gallery-item--empty { background: #f1efe8; border-radius: 14px; padding: 12px; align-items: center; }
  .fw-gallery-placeholder { width: 100%; height: auto; max-height: 220px; fill: #c9c5b8; }
  .fw-gallery-empty { text-align: center; background: #f4f2ec; border-radius: 14px; padding: 40px 20px; color: #5d6476; }
  .fw-gallery-cta { text-align: center; margin-top: 36px; }
  .fw-lightbox { position: fixed; inset: 0; z-index: 9998; background: rgba(12,16,24,.92); display: flex; align-items: center; justify-content: center; padding: 24px 64px; }
  .fw-lightbox[hidden] { display: none; }
  .fw-lightbox-figure { margin: 0; max-width: 100%; max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .fw-lightbox-figure img { max-width: 100%; max-height: calc(100vh - 110px); object-fit: contain; border-radius: 8px; }
  .fw-lightbox-figure figcaption { color: #e7e9ee; font-size: 14px; text-align: center; }
  .fw-lightbox-close, .fw-lightbox-nav { position: absolute; background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 50%; width: 44px; height: 44px; font-size: 28px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .fw-lightbox-close:hover, .fw-lightbox-nav:hover { background: rgba(255,255,255,.25); }
  .fw-lightbox-close { top: 16px; right: 16px; }
  .fw-lightbox-nav.is-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .fw-lightbox-nav.is-next { right: 12px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 989px) { .fw-gallery-grid, .fw-gallery-grid--4 { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 600px) {
    .fw-gallery-title { font-size: 30px; }
    .fw-gallery-grid, .fw-gallery-grid--2, .fw-gallery-grid--4 { grid-template-columns: 1fr; }
    .fw-gallery-item--wide { grid-column: auto; }
    .fw-gallery-item--wide .fw-gallery-open { aspect-ratio: 4 / 3; }
    .fw-lightbox { padding: 16px; }
    .fw-lightbox-nav { top: auto; bottom: 16px; transform: none; }
    .fw-lightbox-nav.is-prev { left: 16px; } .fw-lightbox-nav.is-next { right: 16px; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('fw-gallery-{{ section.id }}');
  if (!root) return;
  var scope = root.parentNode;
  var lb = scope.querySelector('[data-fw-lightbox]');
  var img = lb.querySelector('[data-fw-lb-img]');
  var cap = lb.querySelector('[data-fw-lb-cap]');
  var items = Array.prototype.map.call(root.querySelectorAll('[data-fw-gallery-full]'), function (t) {
    return { src: t.innerHTML.trim().replace(/&amp;/g, '&'), caption: t.getAttribute('data-caption') || '' };
  });
  var idx = 0, last = null;
  function show(i) {
    if (!items.length) return;
    idx = (i + items.length) % items.length;
    img.src = items[idx].src; img.alt = items[idx].caption; cap.textContent = items[idx].caption;
  }
  function open(i) { last = document.activeElement; show(i); lb.hidden = false; document.body.style.overflow = 'hidden'; lb.querySelector('[data-fw-lb-close]').focus(); }
  function close() { lb.hidden = true; document.body.style.overflow = ''; if (last) last.focus(); }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('[data-fw-gallery-open]');
    if (b) open(parseInt(b.getAttribute('data-fw-gallery-open'), 10));
  });
  lb.addEventListener('click', function (e) {
    if (e.target.closest('[data-fw-lb-close]') || e.target === lb) close();
    else if (e.target.closest('[data-fw-lb-prev]')) show(idx - 1);
    else if (e.target.closest('[data-fw-lb-next]')) show(idx + 1);
  });
  document.addEventListener('keydown', function (e) {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
})();
</script>

{% schema %}
{
  "name": "FurrWell Gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside our clinic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clinic Gallery" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Take a look inside FurrWell Vets Clinic in WAPDA Town, Lahore: our consultation rooms, our team and some of the pets we care for." },
    { "type": "select", "id": "columns", "label": "Photos per row (desktop)", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book an Appointment" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to open the booking popup" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "wide", "label": "Show wide (2 columns)", "default": false }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    { "name": "FurrWell Gallery", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] }
  ]
}
{% endschema %}
