<!-- /sections/furrwell-footer.liquid -->
<div class="fw-scope">
  <footer class="fw-footer">
    <div class="fw-wrap fw-footer-top">
      <div class="fw-footer-brand">
        <span class="fw-brand-word">{{ section.settings.brand_name | default: shop.name }}</span>
        {% if section.settings.address != blank %}<p style="font-size:13px;max-width:250px;">{{ section.settings.address }}</p>{% endif %}
        {% if section.settings.phone != blank or section.settings.email != blank %}
        <p style="font-size:13px;">{{ section.settings.phone }}{% if section.settings.phone != blank and section.settings.email != blank %} &middot; {% endif %}{{ section.settings.email }}</p>
        {% endif %}
        {% if section.settings.hours != blank %}<p style="font-size:13px;">{{ section.settings.hours }}</p>{% endif %}
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'link_column' %}
        <div class="fw-footer-col" {{ block.shopify_attributes }}>
          <span class="fw-footer-heading">{{ block.settings.heading }}</span>
          {% for link in linklists[block.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="fw-wrap fw-footer-bottom">
      <span class="fw-ph" style="color:#8a8a90;">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. All rights reserved.</span>
      <div class="fw-footer-social">
        {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 9V6a2 2 0 0 1 2-2h2V1h-3a4 4 0 0 0-4 4v4H8v3h3v9h4v-9h3l1-3h-4Z"/></svg></a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 3c.5 3 2.5 5 5.5 5.3V12c-2-.1-3.8-.8-5.5-2v6.6a6 6 0 1 1-6-6.6c.3 0 .7 0 1 .1V13a2.6 2.6 0 1 0 2 2.6V3Z"/></svg></a>
        {% endif %}
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "FurrWell Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "FurrWell Vets Clinic" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "hours", "label": "Hours" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_column", "settings": { "heading": "Shop" } },
      { "type": "link_column", "settings": { "heading": "Vet Services" } },
      { "type": "link_column", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
