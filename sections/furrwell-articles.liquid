<!-- /sections/furrwell-articles.liquid -->
<div class="fw-scope">
  {% assign blog = blogs[section.settings.blog] %}
  <section class="fw-articles">
    <div class="fw-wrap">
      <div class="fw-section-head">
        <h2>{{ section.settings.heading | default: 'Pet Care Tips' }}</h2>
        <span class="fw-rule"></span>
        {% if blog %}<a href="{{ blog.url }}" style="font-size:14px;font-weight:700;">View all articles &rarr;</a>{% endif %}
      </div>

      <div class="fw-articles-grid">
        {% if blog != blank and blog.articles.size > 0 %}
          {% for article in blog.articles limit: section.settings.limit %}
          <a href="{{ article.url }}" class="fw-card fw-article-card">
            <div class="fw-article-img">
              {% if article.image %}
              <img src="{{ article.image | img_url: '500x300', crop: 'center' }}" alt="{{ article.title | escape }}" loading="lazy">
              {% else %}
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.4"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/><path d="M9 12l2 2 4-4"/></svg>
              {% endif %}
            </div>
            <div class="fw-article-body">
              {% if article.tags.size > 0 %}<span class="fw-article-cat">{{ article.tags.first }}</span>{% endif %}
              <h3>{{ article.title }}</h3>
              <span>Read more &rarr;</span>
            </div>
          </a>
          {% endfor %}
        {% else %}
          {% for i in (1..3) %}
          <div class="fw-card fw-article-card">
            <div class="fw-article-img">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.4"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5Z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <div class="fw-article-body">
              <span class="fw-ph">Select a blog to show articles</span>
            </div>
          </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Pet Care Tips",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pet Care Tips" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Articles to show", "min": 3, "max": 6, "step": 3, "default": 3 }
  ]
}
{% endschema %}
