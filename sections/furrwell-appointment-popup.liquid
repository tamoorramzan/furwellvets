<!-- /sections/furrwell-appointment-popup.liquid -->
{%- comment -%}
  Book-an-appointment popup. Opens from any link whose href ends with
  #book-appointment (e.g. /pages/contact#book-appointment) or any element
  with data-fw-book. Step 1: pick Online Consultation or Physical Exam.
  Step 2: Shopify contact form; the chosen type is sent as "Appointment type".
{%- endcomment -%}
<div class="fw-appt" id="fw-appt" data-fw-appt hidden>
  <div class="fw-appt-backdrop" data-fw-appt-close></div>
  <div class="fw-appt-dialog" role="dialog" aria-modal="true" aria-labelledby="fw-appt-title">
    <button type="button" class="fw-appt-x" data-fw-appt-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    {%- comment -%} Step 1: choose type {%- endcomment -%}
    <div class="fw-appt-step" data-fw-appt-step="choose">
      <h2 id="fw-appt-title" class="fw-appt-title">{{ section.settings.title_before }} <span>{{ section.settings.title_highlight }}</span> {{ section.settings.title_after }}</h2>
      <div class="fw-appt-options">
        <button type="button" class="fw-appt-option" data-fw-appt-pick="online">
          <span class="fw-appt-art">
            {% if section.settings.online_image != blank %}
              {{ section.settings.online_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: section.settings.online_title }}
            {% else %}
              <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="11" height="17" rx="2"/><path d="M11 16h3"/><path d="M4 7v4a3 3 0 0 0 6 0V7"/><path d="M7 14v2a4 4 0 0 0 4 4h0"/><circle cx="18.5" cy="18.5" r="3" fill="var(--fw-gold)" stroke="var(--fw-gold)"/></svg>
            {% endif %}
          </span>
          <span class="fw-appt-opt-title">{{ section.settings.online_title }}</span>
          <span class="fw-appt-opt-sub">{{ section.settings.online_text }}</span>
        </button>
        <button type="button" class="fw-appt-option" data-fw-appt-pick="physical">
          <span class="fw-appt-art">
            {% if section.settings.physical_image != blank %}
              {{ section.settings.physical_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: section.settings.physical_title }}
            {% else %}
              <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="var(--fw-navy)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M5 21v-1a7 7 0 0 1 14 0v1"/><path d="M9 14.5v2.5a2 2 0 0 0 4 0"/><circle cx="15.5" cy="17" r="1.3" fill="var(--fw-gold)" stroke="var(--fw-gold)"/></svg>
            {% endif %}
          </span>
          <span class="fw-appt-opt-title">{{ section.settings.physical_title }}</span>
          <span class="fw-appt-opt-sub">{{ section.settings.physical_text }}</span>
        </button>
      </div>
      <div class="fw-appt-center">
        <button type="button" class="fw-appt-ghost" data-fw-appt-close>{{ section.settings.browse_label }}</button>
      </div>
    </div>

    {%- comment -%} Step 2: form {%- endcomment -%}
    <div class="fw-appt-step" data-fw-appt-step="form" hidden>
      {%- form 'contact', id: 'fw-appointment-form', class: 'fw-appt-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="fw-appt-done" data-fw-appt-success>
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--fw-teal)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
            <h2 class="fw-appt-title">{{ section.settings.success_title }}</h2>
            <p>{{ section.settings.success_text }}</p>
            <button type="button" class="fw-appt-submit" data-fw-appt-close>Close</button>
          </div>
        {%- else -%}
          <button type="button" class="fw-appt-back" data-fw-appt-back>&larr; Change appointment type</button>
          <h2 class="fw-appt-title fw-appt-title--sm">Book: <span data-fw-appt-label>Online Consultation</span></h2>
          <p class="fw-appt-note" data-fw-appt-only="online">{{ section.settings.online_note }}</p>
          <p class="fw-appt-note" data-fw-appt-only="physical">{{ section.settings.physical_note }}</p>

          {%- if form.errors -%}
            <div class="fw-appt-error" data-fw-appt-has-errors>{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <input type="hidden" name="contact[Appointment type]" value="Online Consultation" data-fw-appt-type>

          <div class="fw-appt-grid">
            <label>Your name *<input type="text" name="contact[name]" required autocomplete="name"></label>
            <label>Email *<input type="email" name="contact[email]" required autocomplete="email"></label>
            <label>WhatsApp / phone *<input type="tel" name="contact[phone]" required autocomplete="tel" placeholder="+92 3XX XXXXXXX"></label>
            <label data-fw-appt-only="online">Country *<input type="text" name="contact[Country]" required autocomplete="country-name"></label>
            <label data-fw-appt-only="physical">Area / city<input type="text" name="contact[Area]" value="Lahore"></label>
            <label>Pet name *<input type="text" name="contact[Pet name]" required></label>
            <label>Pet type *
              <select name="contact[Pet type]" required>
                <option value="">Choose</option>
                <option>Dog</option><option>Cat</option><option>Bird</option><option>Fish</option><option>Rabbit</option><option>Other</option>
              </select>
            </label>
            <label>Pet age<input type="text" name="contact[Pet age]" placeholder="e.g. 2 years"></label>
            <label>Preferred date *<input type="date" name="contact[Preferred date]" required data-fw-appt-date></label>
            <label>Preferred time *
              <select name="contact[Preferred time]" required>
                <option value="">Choose</option>
                <option>Morning</option><option>Afternoon</option><option>Evening</option>
              </select>
            </label>
            <label data-fw-appt-only="online">Consult via *
              <select name="contact[Consult via]" required>
                <option value="">Choose</option>
                <option>WhatsApp video call</option><option>WhatsApp voice call</option><option>Phone call</option>
              </select>
            </label>
            <label class="fw-appt-full">Reason for visit / symptoms *<textarea name="contact[body]" rows="3" required></textarea></label>
          </div>
          <button type="submit" class="fw-appt-submit">{{ section.settings.submit_label }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .fw-appt { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px; font-family: 'Work Sans', system-ui, sans-serif; }
  .fw-appt[hidden] { display: none; }
  .fw-appt-backdrop { position: absolute; inset: 0; background: rgba(20,28,40,.55); }
  .fw-appt-dialog { position: relative; background: #fdfbf6; border-radius: 20px; width: 100%; max-width: 820px; max-height: calc(100vh - 32px); overflow-y: auto; padding: 40px 36px 32px; box-shadow: 0 24px 60px rgba(0,0,0,.25); }
  .fw-appt-x { position: absolute; top: 14px; right: 14px; background: none; border: 0; color: #5d6476; cursor: pointer; padding: 6px; border-radius: 50%; }
  .fw-appt-x:hover { background: rgba(0,0,0,.06); }
  .fw-appt-title { font-family: 'Newsreader', Georgia, serif; font-size: 32px; line-height: 1.2; text-align: center; color: var(--fw-navy); margin: 0 0 28px; }
  .fw-appt-title span { color: var(--fw-teal); text-decoration: underline; text-decoration-color: var(--fw-gold); text-underline-offset: 6px; }
  .fw-appt-title--sm { font-size: 26px; margin-bottom: 8px; text-align: left; }
  .fw-appt-title--sm span { text-decoration: none; }
  .fw-appt-options { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; }
  .fw-appt-option { display: flex; flex-direction: column; align-items: center; gap: 8px; background: #fff; border: 1.5px solid #e6e2d6; border-radius: 16px; padding: 28px 18px; cursor: pointer; transition: border-color .2s, transform .2s, box-shadow .2s; font: inherit; }
  .fw-appt-option:hover, .fw-appt-option:focus-visible { border-color: var(--fw-teal); transform: translateY(-3px); box-shadow: 0 10px 24px rgba(31,45,74,.10); outline: none; }
  .fw-appt-art { width: 120px; height: 120px; border-radius: 50%; background: #e2f0ee; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 6px; }
  .fw-appt-art img { width: 100%; height: 100%; object-fit: contain; }
  .fw-appt-opt-title { font-size: 22px; font-weight: 700; color: var(--fw-navy); }
  .fw-appt-opt-sub { font-size: 14px; color: #5d6476; }
  .fw-appt-center { text-align: center; margin-top: 24px; }
  .fw-appt-ghost { background: none; border: 1px solid var(--fw-navy); color: var(--fw-navy); border-radius: 999px; padding: 10px 22px; font: inherit; font-size: 14px; cursor: pointer; }
  .fw-appt-ghost:hover { background: var(--fw-navy); color: #fff; }
  .fw-appt-back { background: none; border: 0; color: var(--fw-teal); font: inherit; font-size: 14px; cursor: pointer; padding: 0; margin-bottom: 14px; }
  .fw-appt-note { font-size: 14px; color: #5d6476; margin: 0 0 18px; }
  .fw-appt-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px 16px; }
  .fw-appt-grid label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: #22242c; }
  .fw-appt-grid label[hidden] { display: none; }
  .fw-appt-full { grid-column: 1 / -1; }
  .fw-appt-grid input, .fw-appt-grid select, .fw-appt-grid textarea { font: inherit; font-weight: 400; font-size: 14px; padding: 11px 12px; border: 1px solid #d9d5c9; border-radius: 10px; background: #fff; color: #22242c; width: 100%; box-sizing: border-box; }
  .fw-appt-grid input:focus, .fw-appt-grid select:focus, .fw-appt-grid textarea:focus { outline: none; border-color: var(--fw-teal); box-shadow: 0 0 0 3px rgba(76,156,151,.15); }
  .fw-appt-submit { margin-top: 20px; width: 100%; background: var(--fw-navy); color: #fff; border: 0; border-radius: 999px; padding: 14px 22px; font: inherit; font-weight: 700; font-size: 15px; cursor: pointer; }
  .fw-appt-submit:hover { background: #1f3550; }
  .fw-appt-error { background: #fcebeb; color: #791f1f; border-radius: 10px; padding: 10px 14px; font-size: 14px; margin-bottom: 14px; }
  .fw-appt-done { text-align: center; padding: 10px 0; }
  .fw-appt-done .fw-appt-title { margin: 12px 0 8px; }
  .fw-appt-done p { color: #5d6476; font-size: 15px; }
  .fw-appt-done .fw-appt-submit { width: auto; padding: 12px 34px; }
  body.fw-appt-open { overflow: hidden; }
  @media (max-width: 640px) {
    .fw-appt-dialog { padding: 36px 18px 24px; border-radius: 16px; }
    .fw-appt-title { font-size: 24px; margin-bottom: 20px; }
    .fw-appt-options { grid-template-columns: 1fr; gap: 12px; }
    .fw-appt-option { flex-direction: row; text-align: left; padding: 14px; gap: 14px; flex-wrap: wrap; }
    .fw-appt-art { width: 64px; height: 64px; margin: 0; }
    .fw-appt-art svg { width: 40px; height: 40px; }
    .fw-appt-option .fw-appt-opt-title { font-size: 18px; }
    .fw-appt-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
(function () {
  var root = document.querySelector('[data-fw-appt]');
  if (!root) return;
  var stepChoose = root.querySelector('[data-fw-appt-step="choose"]');
  var stepForm = root.querySelector('[data-fw-appt-step="form"]');
  var typeInput = root.querySelector('[data-fw-appt-type]');
  var label = root.querySelector('[data-fw-appt-label]');
  var dateInput = root.querySelector('[data-fw-appt-date]');
  var names = { online: {{ section.settings.online_title | json }}, physical: {{ section.settings.physical_title | json }} };
  var lastFocus = null;

  if (dateInput) {
    var d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    dateInput.min = d.toISOString().slice(0, 10);
  }

  function show(step) {
    stepChoose.hidden = step !== 'choose';
    stepForm.hidden = step !== 'form';
  }
  function setType(kind) {
    if (typeInput) typeInput.value = names[kind];
    if (label) label.textContent = names[kind];
    root.querySelectorAll('[data-fw-appt-only]').forEach(function (el) {
      var on = el.getAttribute('data-fw-appt-only') === kind;
      el.hidden = !on;
      el.querySelectorAll('input,select,textarea').forEach(function (f) { f.disabled = !on; });
    });
  }
  function open(step) {
    lastFocus = document.activeElement;
    root.hidden = false;
    document.body.classList.add('fw-appt-open');
    show(step || 'choose');
    var first = root.querySelector('[data-fw-appt-step]:not([hidden]) button, [data-fw-appt-step]:not([hidden]) input');
    if (first) first.focus();
  }
  function close() {
    root.hidden = true;
    document.body.classList.remove('fw-appt-open');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.addEventListener('click', function (e) {
    var t = e.target.closest('a[href$="#book-appointment"], [data-fw-book]');
    if (t) { e.preventDefault(); open('choose'); return; }
    if (!root.contains(e.target)) return;
    var pick = e.target.closest('[data-fw-appt-pick]');
    if (pick) { var k = pick.getAttribute('data-fw-appt-pick'); try { sessionStorage.setItem('fwApptType', k); } catch (err) {} setType(k); show('form'); var f = stepForm.querySelector('input:not([type=hidden]):not([disabled])'); if (f) f.focus(); return; }
    if (e.target.closest('[data-fw-appt-back]')) { show('choose'); return; }
    if (e.target.closest('[data-fw-appt-close]')) { close(); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !root.hidden) { close(); return; }
    if ((e.key === 'Enter' || e.key === ' ') && e.target.matches && e.target.matches('[data-fw-book]')) { e.preventDefault(); open('choose'); }
  });

  var saved = null; try { saved = sessionStorage.getItem('fwApptType'); } catch (err) {}
  setType(saved === 'physical' ? 'physical' : 'online');
  // Reopen after Shopify reloads the page following a submit (success or errors).
  var apptForm = root.querySelector('form');
  if (apptForm) apptForm.addEventListener('submit', function () { try { sessionStorage.setItem('fwApptSubmitted', '1'); } catch (err) {} });
  var apptSent = false; try { apptSent = sessionStorage.getItem('fwApptSubmitted') === '1'; sessionStorage.removeItem('fwApptSubmitted'); } catch (err) {}
  if (apptSent && (root.querySelector('[data-fw-appt-success]') || root.querySelector('[data-fw-appt-has-errors]'))) {
    open('form');
  } else if (location.hash === '#book-appointment') {
    open('choose');
  }
})();
</script>

{% schema %}
{
  "name": "Appointment Popup",
  "settings": [
    { "type": "paragraph", "content": "Opens from any link that ends with #book-appointment, e.g. /pages/contact#book-appointment" },
    { "type": "text", "id": "title_before", "label": "Title (before highlight)", "default": "I want to book an" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight", "default": "appointment" },
    { "type": "text", "id": "title_after", "label": "Title (after highlight)", "default": "for" },
    { "type": "header", "content": "Online consultation" },
    { "type": "image_picker", "id": "online_image", "label": "Image" },
    { "type": "text", "id": "online_title", "label": "Title", "default": "Online Consultation" },
    { "type": "text", "id": "online_text", "label": "Subtitle", "default": "Anywhere in the world" },
    { "type": "text", "id": "online_note", "label": "Note above form", "default": "Our vet will contact you on WhatsApp to confirm the time of your call." },
    { "type": "header", "content": "Physical exam" },
    { "type": "image_picker", "id": "physical_image", "label": "Image" },
    { "type": "text", "id": "physical_title", "label": "Title", "default": "Physical Exam" },
    { "type": "text", "id": "physical_text", "label": "Subtitle", "default": "Currently available in Lahore, Pakistan" },
    { "type": "text", "id": "physical_note", "label": "Note above form", "default": "Visit us at Plot 126, Block D2, WAPDA Town, Lahore. We'll confirm your appointment on WhatsApp." },
    { "type": "header", "content": "Buttons and messages" },
    { "type": "text", "id": "browse_label", "label": "Close button", "default": "Neither, just browsing" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Request appointment" },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "Request received" },
    { "type": "textarea", "id": "success_text", "label": "Success text", "default": "Thank you! Our team will contact you on WhatsApp shortly to confirm your appointment." }
  ]
}
{% endschema %}
