<!-- /sections/furrwell-testimonials.liquid -->
<div class="fw-scope">
  <section class="fw-testimonials">
    <div class="fw-wrap">
      <h2 style="font-size:26px;margin-bottom:26px;">{{ section.settings.heading | default: 'What pet owners say' }}</h2>
      <div class="fw-testimonials-grid">
        {% for block in section.blocks %}
        <div class="fw-card fw-testimonial" {{ block.shopify_attributes }}>
          <div class="fw-stars">
            {% assign rating = block.settings.rating | default: 5 %}
            {% for i in (1..5) %}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="{% if i <= rating %}var(--fw-gold){% else %}#e4e1d6{% endif %}"><path d="M12 2l3 7h7l-5.7 4.3L18 21l-6-4.3L6 21l1.7-7.7L2 9h7z"/></svg>
            {% endfor %}
          </div>
          <p class="fw-testimonial-quote">{{ block.settings.quote | default: '[Add a real customer review here]' }}</p>
          <div class="fw-testimonial-foot">
            <span class="fw-testimonial-author">{{ block.settings.author | default: '[Customer name]' }}</span>
            {% if block.settings.source != blank %}
            <span class="fw-testimonial-source">
              {% if block.settings.source contains 'Google' %}<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.3c0-.8-.1-1.5-.2-2.3H12v4.3h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.7c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.8 14.2a6.6 6.6 0 0 1 0-4.3V7.1H2.1a11 11 0 0 0 0 9.9l3.7-2.8z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4z"/></svg>{% endif %}
              {{ block.settings.source }}
            </span>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% if section.settings.all_reviews_url != blank %}
      <div class="fw-testimonials-more">
        <a href="{{ section.settings.all_reviews_url }}" target="_blank" rel="noopener">{{ section.settings.all_reviews_label | default: 'See all reviews on Google' }} &rarr;</a>
      </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FurrWell Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What pet owners say" },
    { "type": "url", "id": "all_reviews_url", "label": "All reviews link", "info": "e.g. your Google Maps reviews link" },
    { "type": "text", "id": "all_reviews_label", "label": "All reviews link text", "default": "See all reviews on Google" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "text", "id": "source", "label": "Source", "default": "Google review" }
      ]
    }
  ],
  "max_blocks": 9,
  "default": {
    "blocks": [
      { "type": "testimonial" },
      { "type": "testimonial" },
      { "type": "testimonial" }
    ]
  }
}
{% endschema %}
