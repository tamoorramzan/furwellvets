{%- comment -%}
  Animated 3D-style pet icons for the Shop by Pet tiles.
  Usage: {% render 'fw-pet-icon-3d', icon: 'dog' %}  (dog, cat, bird, fish)
{%- endcomment -%}
{%- case icon -%}
  {%- when 'dog' -%}
<svg class="fw-pet-3d" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><defs>
              <radialGradient id="sbp-dg" cx="38%" cy="30%" r="80%"><stop offset="0" stop-color="#F7DDB2"/><stop offset=".55" stop-color="#E0A964"/><stop offset="1" stop-color="#A86D2E"/></radialGradient>
              <radialGradient id="sbp-de" cx="40%" cy="25%" r="85%"><stop offset="0" stop-color="#B07A45"/><stop offset="1" stop-color="#6B4220"/></radialGradient>
              <radialGradient id="sbp-bl" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#F3FF9A"/><stop offset=".6" stop-color="#C8E03C"/><stop offset="1" stop-color="#86A012"/></radialGradient></defs>
              <ellipse cx="48" cy="94" rx="26" ry="4" fill="#000" opacity=".15"/>
              <ellipse class="sbp-a" cx="98" cy="94" rx="9" ry="2.5" fill="#000" style="transform-origin:98px 94px;animation:sbp-shad .9s ease-in-out infinite"/>
              <g class="sbp-a" style="transform-origin:48px 88px;animation:sbp-tilt 2.4s ease-in-out infinite">
              <ellipse class="sbp-a" cx="24" cy="46" rx="11" ry="22" fill="url(#sbp-de)" style="transform-origin:28px 28px;animation:sbp-ear 1.2s ease-in-out infinite"/>
              <ellipse class="sbp-a" cx="72" cy="46" rx="11" ry="22" fill="url(#sbp-de)" style="transform-origin:68px 28px;animation:sbp-ear 1.2s ease-in-out infinite reverse"/>
              <circle cx="48" cy="56" r="30" fill="url(#sbp-dg)"/>
              <ellipse cx="48" cy="69" rx="14" ry="10" fill="#FBEBD3"/>
              <circle cx="38" cy="51" r="4.5" fill="#2A1A0E"/><circle cx="58" cy="51" r="4.5" fill="#2A1A0E"/>
              <circle cx="39.5" cy="49.5" r="1.4" fill="#fff"/><circle cx="59.5" cy="49.5" r="1.4" fill="#fff"/>
              <ellipse cx="48" cy="63" rx="6" ry="4" fill="#2A1A0E"/>
              <path d="M44 72 Q48 84 52 72 Z" fill="#E8667A"/>
              <ellipse cx="38" cy="38" rx="9" ry="4" fill="#fff" opacity=".35"/></g>
              <g class="sbp-a" style="animation:sbp-bounce .9s cubic-bezier(.3,0,.5,1) infinite">
              <circle cx="98" cy="84" r="9" fill="url(#sbp-bl)"/><path d="M90 80 Q98 86 106 80" stroke="#fff" stroke-width="1.6" fill="none"/></g>
              </svg>
  {%- when 'cat' -%}
<svg class="fw-pet-3d" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><defs>
              <radialGradient id="sbp-cg" cx="38%" cy="28%" r="80%"><stop offset="0" stop-color="#FFD9AE"/><stop offset=".55" stop-color="#F0A35E"/><stop offset="1" stop-color="#B8672A"/></radialGradient>
              <radialGradient id="sbp-yg" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#FFC4DA"/><stop offset=".6" stop-color="#EC6F9B"/><stop offset="1" stop-color="#A83A63"/></radialGradient></defs>
              <ellipse cx="44" cy="94" rx="28" ry="4" fill="#000" opacity=".15"/>
              <polygon points="14,46 20,10 40,30" fill="url(#sbp-cg)"/><polygon points="74,46 68,10 48,30" fill="url(#sbp-cg)"/>
              <polygon points="20,38 22,20 32,30" fill="#F4A7B0"/><polygon points="68,38 66,20 56,30" fill="#F4A7B0"/>
              <ellipse cx="44" cy="58" rx="32" ry="28" fill="url(#sbp-cg)"/>
              <g class="sbp-a" style="animation:sbp-look 1.6s ease-in-out infinite">
              <ellipse cx="33" cy="54" rx="5" ry="7" fill="#fff"/><ellipse cx="55" cy="54" rx="5" ry="7" fill="#fff"/>
              <ellipse cx="35" cy="56" rx="3" ry="5" fill="#2D6B3A"/><ellipse cx="57" cy="56" rx="3" ry="5" fill="#2D6B3A"/></g>
              <polygon points="40,65 48,65 44,70" fill="#D9566F"/>
              <path d="M22 66 L34 68 M22 73 L34 71 M66 66 L54 68 M66 73 L54 71" stroke="#6B3A12" stroke-width="1.5" stroke-linecap="round"/>
              <ellipse cx="32" cy="40" rx="10" ry="4" fill="#fff" opacity=".35"/>
              <g class="sbp-a" style="transform-origin:94px 84px;animation:sbp-roll 1.6s ease-in-out infinite">
              <circle cx="94" cy="84" r="11" fill="url(#sbp-yg)"/>
              <path d="M85 78 Q94 86 103 78 M84 86 Q94 92 104 86 M90 74 Q86 84 92 94" stroke="#FFD7E5" stroke-width="1.3" fill="none"/></g>
              <ellipse class="sbp-a" cx="80" cy="80" rx="9" ry="7" fill="url(#sbp-cg)" style="transform-origin:66px 78px;animation:sbp-swipe 1.6s ease-in-out infinite"/>
              </svg>
  {%- when 'bird' -%}
<svg class="fw-pet-3d" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><defs>
              <radialGradient id="sbp-pg" cx="45%" cy="25%" r="85%"><stop offset="0" stop-color="#E4E7EC"/><stop offset=".55" stop-color="#9AA1AC"/><stop offset="1" stop-color="#5A616C"/></radialGradient>
              <linearGradient id="sbp-pw" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7C8490"/><stop offset="1" stop-color="#3E444D"/></linearGradient>
              <linearGradient id="sbp-pt" x1="1" y1="0" x2="0" y2="0"><stop offset="0" stop-color="#E8394F"/><stop offset="1" stop-color="#9E1428"/></linearGradient></defs>
              <ellipse class="sbp-a" cx="58" cy="95" rx="24" ry="3.5" fill="#000" style="transform-origin:58px 95px;animation:sbp-shad 1.1s ease-in-out infinite"/>
              <g class="sbp-a" style="animation:sbp-bob 1.1s ease-in-out infinite">
              <path class="sbp-a" d="M54 50 Q42 16 22 18 Q36 34 46 56 Z" fill="#4A5059" style="transform-origin:54px 52px;animation:sbp-flap2 .55s ease-in-out infinite"/>
              <polygon points="34,58 8,64 10,74 36,66" fill="url(#sbp-pt)"/>
              <ellipse cx="56" cy="57" rx="25" ry="14" fill="url(#sbp-pg)" transform="rotate(-14 56 57)"/>
              <circle cx="80" cy="42" r="13" fill="url(#sbp-pg)"/>
              <ellipse cx="85" cy="42" rx="6.5" ry="5.5" fill="#F3F4F6"/>
              <circle cx="86" cy="40" r="2.3" fill="#141414"/><circle cx="86.8" cy="39.2" r=".8" fill="#fff"/>
              <path d="M91 39 Q102 41 95 53 Q92 47 89 46 Z" fill="#1E1E1E"/>
              <ellipse cx="74" cy="34" rx="6" ry="2.5" fill="#fff" opacity=".45"/>
              <path class="sbp-a" d="M60 52 Q46 12 20 12 Q36 32 48 62 Z" fill="url(#sbp-pw)" style="transform-origin:60px 54px;animation:sbp-flap .55s ease-in-out infinite"/></g>
              </svg>
  {%- when 'fish' -%}
<svg class="fw-pet-3d" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><defs>
              <radialGradient id="sbp-fg" cx="40%" cy="28%" r="80%"><stop offset="0" stop-color="#FFD08A"/><stop offset=".55" stop-color="#F5841F"/><stop offset="1" stop-color="#B4500A"/></radialGradient></defs>
              <g class="sbp-a" style="animation:sbp-swim 2s ease-in-out infinite">
              <polygon class="sbp-a" points="78,54 104,34 100,74" fill="url(#sbp-fg)" style="transform-origin:78px 54px;animation:sbp-tail .5s ease-in-out infinite"/>
              <polygon points="42,36 58,22 62,38" fill="#E06A10"/>
              <ellipse cx="50" cy="55" rx="32" ry="21" fill="url(#sbp-fg)"/>
              <path d="M40 36 Q34 55 40 74" stroke="#fff" stroke-width="6" fill="none"/>
              <path d="M62 37 Q57 55 62 73" stroke="#fff" stroke-width="5" fill="none"/>
              <circle cx="30" cy="50" r="5" fill="#fff"/><circle cx="29" cy="50" r="3" fill="#141414"/><circle cx="28" cy="49" r="1" fill="#fff"/>
              <ellipse cx="46" cy="44" rx="12" ry="4" fill="#fff" opacity=".4"/></g>
              <circle class="sbp-a" cx="16" cy="60" r="3" fill="none" stroke="#7FBFC7" stroke-width="1.5" style="animation:sbp-bub 2s linear infinite"/>
              <circle class="sbp-a" cx="12" cy="66" r="2" fill="none" stroke="#7FBFC7" stroke-width="1.5" style="animation:sbp-bub 2s linear .7s infinite"/>
              <circle class="sbp-a" cx="19" cy="70" r="2.5" fill="none" stroke="#7FBFC7" stroke-width="1.5" style="animation:sbp-bub 2s linear 1.3s infinite"/>
              </svg>
{%- endcase -%}
